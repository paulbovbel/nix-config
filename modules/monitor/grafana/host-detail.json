{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "home-host-detail"
  },
  "spec": {
    "annotations": {
      "list": []
    },
    "editable": false,
    "graphTooltip": 1,
    "links": [],
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "time() - node_boot_time_seconds{host=~\"$host\"}",
            "instant": true,
            "legendFormat": "Uptime",
            "range": false,
            "refId": "A"
          }
        ],
        "description": "Elapsed time since the selected host last booted.",
        "title": "Uptime",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "sum(max by (name) (node_systemd_unit_state{host=~\"$host\",state=\"failed\"}))",
            "instant": true,
            "legendFormat": "Failed units",
            "range": false,
            "refId": "A"
          }
        ],
        "description": "Number of systemd units currently in the failed state.",
        "title": "Failed Systemd Units",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "id": 3,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "sum(smartctl_device_smart_status{host=~\"$host\"} == 0)",
            "instant": true,
            "legendFormat": "Unhealthy disks",
            "range": false,
            "refId": "A"
          }
        ],
        "description": "Number of disks reporting a failed SMART health status.",
        "title": "SMART Failures",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 85
                }
              ]
            },
            "unit": "celsius"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "id": 4,
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "max(node_hwmon_temp_celsius{host=~\"$host\"})",
            "instant": true,
            "legendFormat": "Maximum",
            "range": false,
            "refId": "A"
          }
        ],
        "description": "Highest current temperature reported by hardware sensors.",
        "title": "Highest Temperature",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "percentunit"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 4
        },
        "id": 5,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "1 - avg(rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[$__rate_interval]))",
            "legendFormat": "CPU",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "1 - node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}",
            "legendFormat": "Memory",
            "range": true,
            "refId": "B"
          }
        ],
        "description": "CPU non-idle time and memory utilization for the selected host.",
        "title": "CPU and Memory Usage",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 4
        },
        "id": 6,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "node_load1{host=~\"$host\"}",
            "legendFormat": "Load 1m",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "node_load5{host=~\"$host\"}",
            "legendFormat": "Load 5m",
            "range": true,
            "refId": "B"
          },
          {
            "editorMode": "code",
            "expr": "node_load15{host=~\"$host\"}",
            "legendFormat": "Load 15m",
            "range": true,
            "refId": "C"
          }
        ],
        "description": "One, five, and fifteen minute system load averages.",
        "title": "System Load",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "id": 7,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "100 * (1 - node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs\"})",
            "legendFormat": "{{mountpoint}}",
            "range": true,
            "refId": "A"
          }
        ],
        "description": "Utilization of each persistent filesystem mount.",
        "title": "Filesystem Usage",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "id": 8,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "sum by (device) (rate(node_network_receive_bytes_total{host=~\"$host\",device!~\"lo|veth.*|podman.*\"}[$__rate_interval]))",
            "legendFormat": "{{device}} receive",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "sum by (device) (rate(node_network_transmit_bytes_total{host=~\"$host\",device!~\"lo|veth.*|podman.*\"}[$__rate_interval]))",
            "legendFormat": "{{device}} transmit",
            "range": true,
            "refId": "B"
          }
        ],
        "description": "Receive and transmit throughput by physical network interface.",
        "title": "Network Throughput",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "Bps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        },
        "id": 9,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "sum by (device) (rate(node_disk_read_bytes_total{host=~\"$host\"}[$__rate_interval]))",
            "legendFormat": "{{device}} read",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "sum by (device) (rate(node_disk_written_bytes_total{host=~\"$host\"}[$__rate_interval]))",
            "legendFormat": "{{device}} write",
            "range": true,
            "refId": "B"
          }
        ],
        "description": "Read and write throughput by block device.",
        "title": "Disk Throughput",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              }
            },
            "unit": "celsius"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        },
        "id": 10,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "node_hwmon_temp_celsius{host=~\"$host\"}",
            "legendFormat": "{{chip}} {{sensor}}",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "smartctl_device_temperature{host=~\"$host\"}",
            "legendFormat": "{{device}} SMART",
            "range": true,
            "refId": "B"
          }
        ],
        "description": "Hardware sensor and SMART disk temperatures.",
        "title": "Temperatures",
        "type": "timeseries"
      }
    ],
    "refresh": "1m",
    "schemaVersion": 41,
    "tags": [
      "home-fleet",
      "managed"
    ],
    "templating": {
      "list": [
        {
          "current": {},
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "definition": "label_values(node_uname_info, host)",
          "includeAll": false,
          "label": "Host",
          "multi": false,
          "name": "host",
          "options": [],
          "query": {
            "query": "label_values(node_uname_info, host)",
            "refId": "PrometheusVariableQueryEditor-VariableQuery"
          },
          "refresh": 1,
          "regex": "",
          "sort": 1,
          "type": "query"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "Host Detail",
    "uid": "home-host-detail",
    "version": 1
  }
