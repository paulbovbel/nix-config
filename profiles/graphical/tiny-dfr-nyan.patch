+fn draw_nyan_cat(c: &Context, width: i32, height: i32, sprite: &ImageSurface, frame: u64) {
+    const FRAME_COUNT: u64 = 4;
+
+    let frame_width = sprite.width() / FRAME_COUNT as i32;
+    let frame_x = ((frame / 6) % FRAME_COUNT) as f64 * frame_width as f64;
+    let travel_frame = frame % NYAN_TRAVEL_FRAMES;
+    let scale = height as f64 / sprite.height() as f64;
+    let rendered_width = frame_width as f64 * scale;
+    let x = (width as f64 + rendered_width) * travel_frame as f64 / NYAN_TRAVEL_FRAMES as f64
+        - rendered_width;
+
+    c.save().unwrap();
+    c.rectangle(0.0, 0.0, width as f64, height as f64);
+    c.clip();
+    c.translate(x, 0.0);
+    c.scale(scale, scale);
+    c.rectangle(0.0, 0.0, frame_width as f64, sprite.height() as f64);
+    c.clip();
+    c.set_source_surface(sprite, -frame_x, 0.0).unwrap();
+    c.paint().unwrap();
+    c.restore().unwrap();
+}
