+fn load_nyan_sprite() -> ImageSurface {
+    let mut data = Cursor::new(include_bytes!("@nyanSprite@"));
+    ImageSurface::create_from_png(&mut data).unwrap()
+}
+
+fn draw_nyan_cat(
+    c: &Context,
+    width: i32,
+    height: i32,
+    sprite: &ImageSurface,
+    x: f64,
+    frame: u64,
+) {
+    let frame_width = sprite.width() / NYAN_FRAME_COUNT;
+    let frame_x = ((frame / 6) % NYAN_FRAME_COUNT as u64) as f64 * frame_width as f64;
+    let scale = height as f64 / sprite.height() as f64;
+
+    c.save().unwrap();
+    c.rectangle(0.0, 0.0, width as f64, height as f64);
+    c.clip();
+    c.translate(x, 0.0);
+    c.scale(scale, scale);
+    c.rectangle(0.0, 0.0, frame_width as f64, sprite.height() as f64);
+    c.clip();
+    c.set_source_surface(sprite, -frame_x, 0.0).unwrap();
+    c.paint().unwrap();
+    c.restore().unwrap();
+}
+
+fn draw_nyan_explosion(c: &Context, x: f64, height: i32, frame: u64) {
+    let progress = frame as f64 / NYAN_EXPLOSION_FRAMES as f64;
+    let colors = [
+        (1.0, 0.2, 0.25),
+        (1.0, 0.6, 0.15),
+        (1.0, 0.9, 0.2),
+        (0.25, 0.85, 0.35),
+        (0.2, 0.55, 1.0),
+        (0.7, 0.35, 0.9),
+        (0.95, 0.45, 0.7),
+        (0.65, 0.65, 0.68),
+    ];
+    let directions = [
+        (-1.0, -0.2),
+        (-0.75, -0.75),
+        (-0.2, -1.0),
+        (0.55, -0.85),
+        (1.0, -0.25),
+        (0.8, 0.65),
+        (0.15, 1.0),
+        (-0.7, 0.75),
+    ];
+    let size = 2.0 + (1.0 - progress) * 7.0;
+    for (i, ((dx, dy), color)) in directions.iter().zip(colors.iter()).enumerate() {
+        let distance = progress * (55.0 + i as f64 * 7.0);
+        let px = x + dx * distance;
+        let py = height as f64 / 2.0 + dy * distance + progress * progress * 24.0;
+        c.set_source_rgb(color.0, color.1, color.2);
+        c.rectangle(px - size / 2.0, py - size / 2.0, size, size);
+        c.fill().unwrap();
+    }
+}
