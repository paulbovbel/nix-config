# 1) get laptop age recipient (run on laptop)
age-keygen -y /etc/ssh/ssh_host_ed25519_key > /tmp/laptop.age.pub
# 2) on your repo machine, encrypt your existing private key for laptop
agenix -e secrets/laptop/pbovbel-id_rsa.age -r "$(cat /tmp/laptop.age.pub)"
# when editor opens, paste ~/.ssh/id_rsa contents, save, exit
# 3) apply
sudo nixos-rebuild switch --flake .#laptop
